# Build stage
FROM node:20-alpine AS build

WORKDIR /app

COPY package.json ./
RUN yarn install

COPY . .

ARG REACT_APP_BACKEND_URL
ENV REACT_APP_BACKEND_URL=$REACT_APP_BACKEND_URL

RUN yarn build

# Production stage
FROM nginx:alpine

COPY --from=build /app/build /usr/share/nginx/html

# SPA fallback + /api proxy (aynı docker network uzerinden backend:8001'e) --
# boylece REACT_APP_BACKEND_URL bos birakilip ayni imaj hem yerel docker-compose
# (localhost:3000) hem Cloudflare Tunnel arkasindaki tum hostname'lerde
# (toprax.com.tr/demo.toprax.com.tr/app.toprax.com.tr) ayni-origin calisir --
# tarayici acisindan cross-origin/CORS hic devreye girmez.
# Denetim düzeltmesi (2026-07-24) — nginx'in VARSAYILAN client_max_body_size'ı
# (hiç ayarlanmamışsa) 1 MB'dır; İdari Alanlar'ın toplu ilçe/mahalle içe
# aktarma akışı (geo_import.py'nin ayrıştırdığı ~1100 ilçe / ~60.000 mahalle
# sınırının HEM dosya yüklemesi HEM ayrıştırılmış geometrinin geri POST'u)
# bunu kolayca aşar — istek backend'e hiç ULAŞMADAN nginx'in 413'üyle
# sessizce reddediliyordu ("veri boyutu büyük geliyor" şüphesi doğruydu).
# geo_import.py'nin kendi MAX_UPLOAD_BYTES sınırı (2026-07-25'te 70 MB'a
# yükseltildi) zaten var — nginx bunun ALTINDA kalıp erken keserse backend'in
# Türkçe hata mesajı hiç görünmez, bu yüzden nginx sınırı UYGULAMA sınırının
# ÜZERİNDE (80 MB) tutulur.
# proxy_read_timeout da varsayılan 60s'den yükseltildi — 60.000 kayıtlık
# toplu import (artık insert_many ile toplu, ama yine de saniyeler sürer)
# gateway timeout'a takılmasın diye.
RUN echo 'server { \
  listen 80; \
  client_max_body_size 80M; \
  root /usr/share/nginx/html; \
  index index.html; \
  location /api/ { \
    proxy_pass http://backend:8001/api/; \
    proxy_set_header Host $host; \
    proxy_set_header X-Real-IP $remote_addr; \
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; \
    proxy_set_header X-Forwarded-Proto $scheme; \
    proxy_read_timeout 300s; \
    proxy_send_timeout 300s; \
  } \
  location / { try_files $uri $uri/ /index.html; } \
}' > /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
